# Copy this file to .env and fill in real values.
# .env is git-ignored; this example file is committed, so it must never
# contain a real secret.

# --- OpenSky Network ---
# OAuth2 client credentials. Create an API client under your OpenSky account
# settings to generate these. Basic auth (username/password) was removed in
# March 2026 and no longer works.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
